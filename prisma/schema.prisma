generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STAFF")
  isActive     Boolean  @default(true)
  permissions  String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id             String          @id @default(cuid())
  sku            String          @unique
  name           String
  category       String?
  unit           String          @default("pcs")
  sellingPrice   Decimal         @default(0) @db.Decimal(12, 2)
  costPrice      Decimal         @default(0) @db.Decimal(12, 2)
  reorderLevel   Decimal         @default(0) @db.Decimal(12, 3)
  currentStock   Decimal         @default(0) @db.Decimal(12, 3)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]
}

model Supplier {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  email          String?
  address        String?  @db.Text
  bin            String?
  openingBalance Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  email          String?
  address        String?  @db.Text
  customerType   String   @default("RETAIL")
  creditLimit    Decimal  @default(0) @db.Decimal(12, 2)
  openingBalance Decimal  @default(0) @db.Decimal(12, 2)
  creditBalance  Decimal? @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model StockMovement {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String?
  type        String
  quantity    Decimal  @db.Decimal(12, 3)
  reference   String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id])
}

model PurchaseOrder {
  id            String   @id @default(cuid())
  orderNo       String   @unique
  supplierId    String?
  productId     String?
  quantity      Decimal? @default(1) @db.Decimal(12, 3)
  unitPrice     Decimal? @default(0) @db.Decimal(12, 2)
  status        String   @default("DRAFT")
  total         Decimal  @default(0) @db.Decimal(12, 2)
  paymentStatus String   @default("UNPAID")
  paidAmount    Decimal? @default(0) @db.Decimal(12, 2)
  dueAmount     Decimal? @default(0) @db.Decimal(12, 2)
  items         String?  @db.Text
  notes         String?  @db.Text
  orderDate     DateTime @default(now())
  createdAt     DateTime @default(now())
}

model ProductionOrder {
  id                String    @id @default(cuid())
  orderNo           String    @unique
  productId         String
  plannedQty        Decimal   @db.Decimal(12, 3)
  producedQty       Decimal   @default(0) @db.Decimal(12, 3)
  status            String    @default("PLANNED")
  batchNo           String?
  manufacturingDate DateTime?
  expiryDate        DateTime?
  createdAt         DateTime  @default(now())
}

model SalesOrder {
  id            String   @id @default(cuid())
  orderNo       String   @unique
  customerId    String?
  productId     String?
  quantity      Decimal? @default(1) @db.Decimal(12, 3)
  unitPrice     Decimal? @default(0) @db.Decimal(12, 2)
  status        String   @default("DRAFT")
  total         Decimal  @default(0) @db.Decimal(12, 2)
  paymentStatus String   @default("UNPAID")
  paidAmount    Decimal? @default(0) @db.Decimal(12, 2)
  dueAmount     Decimal? @default(0) @db.Decimal(12, 2)
  vatAmount     Decimal? @default(0) @db.Decimal(12, 2)
  vatPaid       Boolean? @default(false)
  items         String?  @db.Text
  notes         String?  @db.Text
  orderDate     DateTime @default(now())
  createdAt     DateTime @default(now())
}

model ProductReturn {
  id           String   @id @default(cuid())
  returnNo     String   @unique
  salesOrderId String?
  productId    String?
  quantity     Decimal  @db.Decimal(12, 3)
  refundAmount Decimal? @default(0) @db.Decimal(12, 2)
  reason       String
  status       String   @default("PENDING")
  disposition  String   @default("QUARANTINE")
  createdAt    DateTime @default(now())
  id                 String    @id @default(cuid())
  returnNo           String    @unique
  salesOrderId       String?
  invoiceNo          String?
  customerId         String?
  customerName       String?
  productId          String?
  batchNo            String?
  soldQty            Decimal?  @default(0) @db.Decimal(12, 3)
  quantity           Decimal   @db.Decimal(12, 3)
  unitPrice          Decimal?  @default(0) @db.Decimal(12, 2)
  refundAmount       Decimal?  @default(0) @db.Decimal(12, 2)
  reason             String    // Damaged Product, Expired Product, Wrong Product Delivered, Quality Complaint, Partial Return, Courier Return / RTO
  condition          String?   @default("DAMAGED") // SALEABLE, DAMAGED, EXPIRED, OPENED_PACKAGE, WRONG_PRODUCT
  status             String    @default("PENDING") // PENDING, INSPECTED, APPROVED, REJECTED, COMPLETED
  disposition        String    @default("QUARANTINE") // AVAILABLE_STOCK, DAMAGED_SCRAP, EXPIRED_QUARANTINE, QUARANTINE
  qcStatus           String?   @default("PENDING") // PENDING, PASSED, FAILED
  qcNotes            String?   @db.Text
  resolutionType     String?   @default("REFUND") // REFUND, CREDIT_BALANCE, REPLACEMENT
  refundMethod       String?   @default("CASH") // CASH, BANK_TRANSFER, BKASH, CREDIT_BALANCE
  vatAdjustment      Decimal?  @default(0) @db.Decimal(12, 2)
  vatAdjusted        Boolean?  @default(false)
  courierConsignment String?
  courierCharge      Decimal?  @default(0) @db.Decimal(12, 2)
  replacementOrderId String?
  approvedBy         String?
  approvedAt         DateTime?
  inspectedBy        String?
  inspectionDate     DateTime?
  createdAt          DateTime  @default(now())
}

model CourierShipment {
  id             String   @id @default(cuid())
  consignmentId  String?
  provider       String
  salesOrderId   String?
  trackingCode   String?
  status         String   @default("BOOKING_PENDING")
  codAmount      Decimal  @default(0) @db.Decimal(12, 2)
  deliveryCharge Decimal  @default(0) @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
}

model VatTransaction {
  id              String   @id @default(cuid())
  transactionNo   String   @unique
  transactionType String
  taxableAmount   Decimal  @db.Decimal(12, 2)
  vatRate         Decimal  @db.Decimal(6, 3)
  vatAmount       Decimal  @db.Decimal(12, 2)
  transactionDate DateTime @default(now())
  mushakForm      String?
  createdAt       DateTime @default(now())
}

model AccountTransaction {
  id              String   @id @default(cuid())
  transactionNo   String   @unique
  type            String   // "INCOMING" | "OUTGOING"
  category        String   // "SALES_COLLECTION", "CUSTOMER_PAYMENT", "PURCHASE_PAYMENT", "SUPPLIER_PAYMENT", "SALES_RETURN_REFUND", "EXPENSE", "SALARY", "COURIER_COD"
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethod   String   @default("BANK_TRANSFER") // "CASH", "BANK_TRANSFER", "BKASH", "NAGAD", "CHEQUE"
  reference       String?
  partyName       String?
  status          String   @default("COMPLETED") // "COMPLETED", "PENDING", "CANCELLED"
  transactionDate DateTime @default(now())
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?  @db.Text
  createdAt DateTime @default(now())
}
